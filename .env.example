# ─── Claude Agents (Phase 2A) ────────────────────────────────
# Required to execute Claude skills. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override default model (claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# ─── Database (Phase 2B) ─────────────────────────────────────
# Postgres connection string. If unset, the app falls back to the
# in-memory mock dataset (Phase 1 behavior). Agent runs persist to
# data/agent-runs/*.json when there is no DB.
#
# Local dev with the bundled docker-compose:
#   docker compose up -d postgres
#   DATABASE_URL="postgresql://lynx:lynx@localhost:5432/lynx_terminal?schema=public"
#   npx prisma migrate dev
#   npm run db:seed
#
# Supabase / Neon / Vercel Postgres etc.: paste their connection string.
# DATABASE_URL=postgresql://lynx:lynx@localhost:5432/lynx_terminal?schema=public

# The seed creates one portfolio; you can name it here.
# PORTFOLIO_ID will be auto-generated as a cuid and printed by db:seed.
LYNX_PORTFOLIO_NAME="Lynx Capital — Global Equity"

# ─── Market data (Phase 2C) ──────────────────────────────────
# Provider used by `POST /api/refresh/quotes` and the "Refresh quotes"
# button. Default: yahoo (free, no key, via yahoo-finance2; may rate-limit).
#
# MARKET_DATA_PROVIDER=yahoo
# MARKET_DATA_PROVIDER=fmp
# FMP_API_KEY=...   # required when MARKET_DATA_PROVIDER=fmp (free tier: 250 calls/day)

# ─── News (Phase 2C-news) ──────────────────────────────────
# Provider used by `POST /api/refresh/news` and the "Refresh news (IA)"
# button. Defaults to MARKET_DATA_PROVIDER (so a single FMP key powers
# both quotes and news for FMP users).
#
# NEWS_PROVIDER=yahoo  # default if both unset
# NEWS_PROVIDER=fmp    # requires FMP_API_KEY

# ─── Benchmark refresh (Phase 2C+) ───────────────────────────────────
# Ticker fetched alongside positions to advance the benchmark NAV in
# the same daily refresh. Default: SPY. Use a symbol the provider
# understands (Yahoo: SPY, EFA, IWM, ^GSPC; FMP: SPY, ^GSPC).
#
# BENCHMARK_TICKER=SPY

# ─── Earnings calendar (Phase 2C+) ───────────────────────────────────
# Provider for `POST /api/refresh/earnings`. Falls back to
# MARKET_DATA_PROVIDER.
#
# EARNINGS_PROVIDER=yahoo  # default
# EARNINGS_PROVIDER=fmp    # better coverage but requires FMP_API_KEY

# ─── IBKR Flex Query (Phase 2C+) ─────────────────────────────────────
# Pull real trades into the Transaction table via the IBKR Flex Web
# Service. Generate the token + query id in Account Management →
# Settings → Account Settings → Flex Web Service / Flex Queries.
# The query should include the Trades section at minimum.
#
# IBKR_FLEX_TOKEN=...
# IBKR_FLEX_QUERY_ID=...

# ─── Cron auth (Phase 2C+) ───────────────────────────────────────────
# When set, the /api/refresh/* endpoints require either:
#   - Authorization: Bearer ${CRON_SECRET}      (cron/external)
#   - or a same-origin browser fetch             (button in the UI)
# Unset → no auth (dev mode).
#
# CRON_SECRET=use-a-long-random-string
