# ─── Claude Agents (Phase 2A) ────────────────────────────────
# Required to execute Claude skills. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override default model (claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# ─── Database (Phase 2B) ─────────────────────────────────────
# Postgres connection string. If unset, the app falls back to the
# in-memory mock dataset (Phase 1 behavior). Agent runs persist to
# data/agent-runs/*.json when there is no DB.
#
# Local dev with the bundled docker-compose:
#   docker compose up -d postgres
#   DATABASE_URL="postgresql://lynx:lynx@localhost:5432/lynx_terminal?schema=public"
#   npx prisma migrate dev
#   npm run db:seed
#
# Supabase / Neon / Vercel Postgres etc.: paste their connection string.
# DATABASE_URL=postgresql://lynx:lynx@localhost:5432/lynx_terminal?schema=public

# The seed creates one portfolio; you can name it here.
# PORTFOLIO_ID will be auto-generated as a cuid and printed by db:seed.
LYNX_PORTFOLIO_NAME="Lynx Capital — Global Equity"

# ─── Market data (Phase 2C) ──────────────────────────────────
# Provider used by `POST /api/refresh/quotes` and the "Refresh quotes"
# button. Default: yahoo (free, no key, via yahoo-finance2; may rate-limit).
#
# MARKET_DATA_PROVIDER=yahoo
# MARKET_DATA_PROVIDER=fmp
# FMP_API_KEY=...   # required when MARKET_DATA_PROVIDER=fmp (free tier: 250 calls/day)
